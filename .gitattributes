# Enforce consistent, cross-platform line endings
# Default: treat all text as text and normalize to LF in repo
* text=auto eol=lf

# Windows-specific script files keep CRLF in working directory
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell scripts keep LF
*.sh text eol=lf

# Kotlin / Gradle / XML / YAML / Markdown use LF
*.kt text eol=lf
*.kts text eol=lf
*.gradle text eol=lf
*.gradle.kts text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.properties text eol=lf

# Binary files (no EOL normalization)
*.png -text
*.jpg -text
*.jpeg -text
*.gif -text
*.webp -text
*.pdf -text
*.jar -text
